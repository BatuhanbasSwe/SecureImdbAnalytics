# Bu dosyayı .env olarak kopyala ve aşağıdaki değerleri gerçek key'lerle değiştir.
# .env dosyası .gitignore içinde — asla git'e commit etme.

# JWT imzalama anahtarı — rastgele 32+ byte hex (örn: openssl rand -hex 32)
JWT_SECRET=replace_with_random_64_char_hex_string

# Fernet şifreleme anahtarı — base64 url-safe 32 byte
# Üretmek için: python generate_env.py  (bu repo'daki helper script)
FERNET_KEY=replace_with_fernet_key_from_generate_env_py

# OMDb API key — film posterlerini çekmek için (opsiyonel)
# Ücretsiz key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=replace_with_omdb_key
